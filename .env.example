# Safe defaults: AI is off and YouTube writes are simulated.
DRY_RUN=true
AI_ENABLED=false
BOT_DISPLAY_NAME=Kupobot
BOT_MENTION_ALIASES=Kupobot,MogResearchAssistant
PROJECT_URL=https://github.com/pablodcruz/ffxi-agents-server
COMPANION_URL=https://github.com/pablodcruz/ffxi-chat-companion

# YouTube OAuth. Keep all real values outside Git.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_BOT_CHANNEL_ID=
# Optional: skip active-broadcast discovery when the chat ID is already known.
YOUTUBE_LIVE_CHAT_ID=

# AI-assisted mention replies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Generate with: openssl rand -hex 32
SAFETY_HASH_SALT=

# Reply controls.
VIEWER_COOLDOWN_SECONDS=45
GLOBAL_AI_REPLIES_PER_MINUTE=3
GLOBAL_REPLIES_PER_MINUTE=10
DUPLICATE_WINDOW_SECONDS=20
MAX_INPUT_CHARS=500
MAX_REPLY_CHARS=380

# Read-only game status: none, file, or http.
STATUS_SOURCE=none
STATUS_FILE=runtime/status-v1.json
STATUS_URL=
STATUS_BEARER_TOKEN=
STATUS_MAX_AGE_SECONDS=120
